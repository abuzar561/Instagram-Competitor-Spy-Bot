    {
      "parameters": {
        "jsCode": "const row = items[0].json;\nconst isViral = String(row['Is Viral']).toLowerCase() === 'true';\nconst engagement = Number(row['Engagement Rate'] || 0);\nconst threshold = Number(row['Viral Threshold'] || 0);\n\nif (!isViral && engagement < threshold) {\n  return [];\n}\n\nconst message = [\n  '**COMPETITOR ALERT**',\n  `User: @${row.Competitor}`,\n  `Likes: ${row.Likes}`,\n  `Comments: ${row.Comments}`,\n  `Engagement: ${engagement}%`,\n  `Link: ${row['Post URL']}`,\n].join('\\n');\n\nreturn [{ json: { message } }];"
      },
